# CodeSageZ — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=CodeSageZ
VERSION=2.0.0
ENVIRONMENT=development          # development | staging | production

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:3000

# ── Authentication ────────────────────────────────────────────────────────────
# Required in production. Leave empty for open-mode in development.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
CODESAGEZ_API_KEY=

# ── AI Providers ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=                  # Google AI Studio: aistudio.google.com
GITHUB_TOKEN=                    # GitHub PAT for private repo ingestion

# ── Database ──────────────────────────────────────────────────────────────────
# Development default (SQLite — do NOT use in production)
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Production (PostgreSQL / Supabase)
# DATABASE_URL=postgresql://user:password@host:5432/codesagez

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Leave empty for embedded local mode (development only)
CHROMADB_URL=
CHROMA_PERSIST_DIRECTORY=./.chroma
CHROMA_AUTH_TOKEN=               # Required if CHROMADB_URL points to a secured server

# ── Ollama (local model) ──────────────────────────────────────────────────────
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=codesagez-coder

# ── Redis (rate limiting) ─────────────────────────────────────────────────────
# Leave empty to use in-memory rate limiting (not suitable for multi-instance)
REDIS_URL=

# ── Ingestion Limits ──────────────────────────────────────────────────────────
MAX_REPO_SIZE_KB=204800          # 200 MB
MAX_CODE_INPUT_CHARS=10000
TMP_CLONE_DIR=/tmp/codesagez
