# CodeSageZ — copy to .env and fill in values

# Required for LLM features
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: higher-quality code embeddings
# EMBEDDING_PROVIDER=voyage
# VOYAGE_API_KEY=your-voyage-key

# Optional: distributed cache
# REDIS_URL=redis://localhost:6379/0

# Optional: production ChromaDB
# CHROMADB_URL=http://chromadb:8000
# CHROMA_AUTH_TOKEN=your-chroma-token

# API auth (leave empty for open/dev mode)
# CODESAGEZ_API_KEY=your-secret-api-key

# Environment (development | production)
ENVIRONMENT=development
